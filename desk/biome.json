{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "root": false,
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "asNeeded" }
  },
  "files": {
    "includes": [
      "src/main.ts",
      "src/createCyberDesk.ts",
      "src/createCyberDesk.test.ts",
      "src/style.css",
      "scripts/**",
      "index.html",
      "package.json",
      "tsconfig.json",
      "vite.config.ts"
    ]
  }
}
