{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "root": false,
  "files": {
    "includes": ["src/**/*", "!src/model/generated", "scripts/**/*", "index.html"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  }
}
